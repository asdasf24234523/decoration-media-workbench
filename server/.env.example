# 服务端口
PORT=3000

# 数据库（Railway 提供）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=media_workbench

# JWT 密钥（部署时改成强随机字符串）
JWT_SECRET=change-me-to-random-string-in-production

# 前端静态文件目录（部署时填绝对路径）
STATIC_DIR=/Users/picha/.qclaw/workspace-3010ll10ltqof1lk/workbench

# 初始管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 钉钉免登（可选；不填则关闭钉钉登录）
# 在钉钉开发者后台创建「企业内部应用(H5微应用)」后获取
DINGTALK_CORPID=
DINGTALK_APPKEY=
DINGTALK_APPSECRET=
